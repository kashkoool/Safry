# Copy to ".env" next to docker-compose.yml, replace every CHANGE_ME value, then run:
#   scripts/check-env.sh .env
# Never commit .env. In production prefer injecting these from the host's secret manager.

# --- Database ---------------------------------------------------------------------------
# Owner/superuser password (migrations, role setup, backups). URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Password of the restricted runtime login "safry_runtime" the API uses. URL-safe: openssl rand -hex 32
DATABASE_RUNTIME_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- API secrets ------------------------------------------------------------------------
# 32+ random characters. Startup rejects placeholders, anything shorter than 32 characters, and values whose estimated
# entropy is under 112 bits (repeated or patterned strings). Generate with the command shown.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
# Separate key for encrypting MFA (TOTP) secrets; required in production, must differ from JWT_ACCESS_SECRET.
MFA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# --- Transactional e-mail (password reset, e-mail verification) -----------------------------
# Resend (https://resend.com): create an API key (Sending access, one domain) and verify your sending domain first;
# docs/DEPLOYMENT.md, "Transactional email (Resend)". Never commit the real key.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY_FROM_THE_RESEND_DASHBOARD
# Sender on the verified domain, for example: Safry <no-reply@mail.your-domain.tld>
MAIL_FROM=CHANGE_ME_SENDER_ON_YOUR_VERIFIED_RESEND_DOMAIN
# Public https origin of the web app, no path and no trailing slash. E-mailed links are built from it.
APP_BASE_URL=https://CHANGE_ME_YOUR_APP_DOMAIN

# --- HTTP / topology --------------------------------------------------------------------
# Interface and port the web container is published on. Keep 127.0.0.1 behind a TLS terminator.
WEB_BIND=127.0.0.1
WEB_PORT=3001
# Proxy hops in front of the API: 1 = nginx only; 2 = TLS terminator (tls profile / load balancer) + nginx.
TRUST_PROXY=1
# With TRUST_PROXY>=2 keep WEB_BIND=127.0.0.1: a publicly published web port lets clients forge their address (check-env.sh refuses it).
# Empty = same-origin only (recommended). Otherwise comma-separated exact https origins.
CORS_ORIGINS=
# API docs (Swagger) in production: keep false.
SWAGGER_ENABLED=false
# Only for the "tls" profile: public DNS name Caddy gets a certificate for.
# SITE_ADDRESS=app.example.com
# Cloudflare proxy + Origin Certificate (docs/DEPLOYMENT.md section 4): use TRUST_PROXY=2 and
# CADDYFILE=./deploy/caddy/Caddyfile.cloudflare
# CADDY_CERT_DIR=./deploy/caddy/certs   # contains origin.pem and origin.key

# --- Loose staging mode (local test stacks only) ---------------------------------------
# ALLOW_NON_PRODUCTION_DEFAULTS=true (with NODE_ENV=staging) switches off the production safety rules.
# Never set it on a stack that is reachable from the internet. If APP_BASE_URL or CORS_ORIGINS names a
# public https host the API refuses to start unless this second flag is also true (throwaway test hosts only).
# ALLOW_NON_PRODUCTION_ON_PUBLIC_HOST=false

# --- Optional demo seed (profile "seed"; never in a real deployment) ----------------------
BOOTSTRAP_TENANT_CODE=safry
BOOTSTRAP_ADMIN_EMAIL=admin@safry.local
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12_CHARS_MIN
# ALLOW_DEMO_SEED_IN_PRODUCTION=false
# DEMO_SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD_12_CHARS_MIN

# --- Optional API settings not forwarded by docker-compose.yml yet -----------------------------
# These are read by the API (defaults in backend/.env.example) but the compose file does not pass them through; to use
# one, add it under the api service's environment in docker-compose.yml. RATE_LIMIT_IP_PER_MINUTE (300),
# RATE_LIMIT_ACCOUNT_PER_MINUTE (20), RATE_LIMIT_USER_PER_MINUTE (600), RATE_LIMIT_REFRESH_SESSION_PER_MINUTE (30),
# RATE_LIMIT_REFRESH_INVALID_PER_MINUTE (20), RATE_LIMIT_REDIS_URL (unset = in-process limits; set it for more than one
# replica), METRICS_TOKEN (unset = /metrics disabled). DATABASE_MIGRATE_URL is set by the compose file for the one-off
# jobs from POSTGRES_PASSWORD; do not put it in this file.

# --- Image names ------------------------------------------------------------------------
# Images are named <IMAGE_PREFIX>-api|web|migrate:<IMAGE_TAG>. Two checkouts on one host must use different prefixes
# (and COMPOSE_PROJECT_NAME), or one build overwrites the other's images.
# IMAGE_PREFIX=safry-staging
# IMAGE_TAG=local
# COMPOSE_PROJECT_NAME=safry-staging
