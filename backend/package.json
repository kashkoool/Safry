{
  "name": "@safry/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Safry Platform modular backend",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "demo:refresh": "tsx scripts/refresh-demo-data.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:business": "tsx scripts/business-smoke.ts",
    "demo:managers": "tsx scripts/grant-demo-managers.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-platform-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:local": "prisma dev --detach --name safry",
    "db:local:list": "prisma dev ls",
    "db:local:stop": "prisma dev stop safry",
    "test:int": "nest build && vitest run -c vitest.int.config.ts",
    "audit:prod": "tsx scripts/audit-prod.ts",
    "test:routes": "tsx scripts/route-coverage.ts",
    "test:int:all": "nest build && node -e \"require('node:fs').rmSync('test/.coverage',{recursive:true,force:true})\" && vitest run && vitest run -c vitest.int.config.ts && tsx scripts/route-coverage.ts",
    "test:docker": "bash test/docker/run.sh",
    "test:all": "vitest run && pnpm test:int",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10.12.0",
    "fast-check": "4.10.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
