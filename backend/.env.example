NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://safry:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/safry?schema=public
# Generate with: openssl rand -base64 48 (startup rejects placeholders, anything under 32 characters, and values whose
# estimated entropy is under 112 bits, such as repeated or patterned strings)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
# Absolute session lifetime: a login must be repeated after this many hours, however active (1-720).
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=15
CORS_ORIGINS=http://localhost:3001
BOOTSTRAP_TENANT_CODE=safry
BOOTSTRAP_TENANT_NAME=Safry Platform
BOOTSTRAP_ADMIN_EMAIL=admin@safry.local
# Seed only (pnpm db:seed). 12+ characters, never a placeholder. Generate with: openssl rand -base64 18
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12_CHARS_MIN
# Password shared by every demo account the seed creates (same rules). The seed refuses to run without it.
DEMO_SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD_12_CHARS_MIN
# The seed refuses NODE_ENV=production unless this is true.
# ALLOW_DEMO_SEED_IN_PRODUCTION=false
# Login throttle: after LOGIN_MAX_ATTEMPTS failures an e-mail + address pair is blocked with a
# growing delay (capped at LOGIN_LOCKOUT_MINUTES); 4x that many from any addresses block the e-mail for
# LOGIN_LOCKOUT_MINUTES, except from addresses that signed in successfully before. Blocks always expire.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Dedicated key (32+ random chars) for encrypting MFA secrets. Required when NODE_ENV=production and must
# differ from JWT_ACCESS_SECRET; in development it falls back to a key derived from JWT_ACCESS_SECRET.
# MFA_ENCRYPTION_KEY=
# Row-level security (migration 0010): "auto" (default) = on, except for the embedded Prisma dev database; "on" / "off" force it.
# DATABASE_RLS=auto
# DATABASE_APP_ROLE=safry_app
# Owner login for migrations and operator scripts only (never the API). Falls back to DATABASE_URL in some scripts.
# DATABASE_MIGRATE_URL=postgresql://safry:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/safry?schema=public

# Rate limits (requests per minute; defaults shown). Per IP address, per account (login attempts), per signed-in user,
# and for token refresh (per session, and per address for invalid refresh tokens).
# RATE_LIMIT_IP_PER_MINUTE=300
# RATE_LIMIT_ACCOUNT_PER_MINUTE=20
# RATE_LIMIT_USER_PER_MINUTE=600
# RATE_LIMIT_REFRESH_SESSION_PER_MINUTE=30
# RATE_LIMIT_REFRESH_INVALID_PER_MINUTE=20
# Shared rate-limit store. Unset = limits are kept in process memory (fine for one instance; with N replicas the
# effective limits are N times higher). Set it before running more than one replica.
# RATE_LIMIT_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# Prometheus-style /metrics endpoint: disabled (404) unless a token is set; scrapers send "Authorization: Bearer <token>".
# METRICS_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# Staging only (NODE_ENV=staging): relax the production-grade defaults (console mail, open docs, localhost CORS) on a
# local test stack. Default false; refused with any other NODE_ENV. Never set it on a host reachable from the Internet.
# ALLOW_NON_PRODUCTION_DEFAULTS=false
# ALLOW_NON_PRODUCTION_ON_PUBLIC_HOST=false  # second explicit flag: needed only if the loose mode must serve a public https host (refused otherwise)

# Optional: refuse logins that do not name a portal (customer, provider or admin)
# LOGIN_PORTAL_REQUIRED=false

# Transactional e-mail (password reset, e-mail verification).
# console = nothing is sent; the link is printed to the API log (development only, refused in production).
# resend  = Resend HTTP API; needs RESEND_API_KEY and MAIL_FROM. Production must use resend.
MAIL_TRANSPORT=console
# Required only when MAIL_TRANSPORT=resend (create it in the Resend dashboard; never commit the real key).
# RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY_FROM_THE_RESEND_DASHBOARD
# Sender on your verified Resend domain, for example: Safry <no-reply@mail.your-domain.tld>
# MAIL_FROM=CHANGE_ME_SENDER_ON_YOUR_VERIFIED_RESEND_DOMAIN
# Frontend origin the e-mailed links point to (bare origin). Default http://localhost:3001; must be https in production.
APP_BASE_URL=http://localhost:3001
# Optional: provider timeout (default 8000) and the fixed minimum answer time of the "send me a link" endpoints (default 300).
# MAIL_TIMEOUT_MS=8000
# AUTH_MAIL_MIN_RESPONSE_MS=300
# Optional: retry of transient mail failures: total tries (1-5, default 3) and base wait (default 2000 ms; waits are base, then base x 5).
# MAIL_RETRY_ATTEMPTS=3
# MAIL_RETRY_BASE_MS=2000
# Optional: hourly and daily ceilings on outbound mail, in three independent pools so spending one never blocks another (shared across
# replicas when RATE_LIMIT_REDIS_URL is set). When a pool is spent its mail is dropped (the API answers as before and one warning is
# logged per window):
#   registration = verification mail for NEW sign-ups (anonymous, so the one a flood can drain),
#   reset        = reset and resend mail for EXISTING accounts,
#   security     = notices to an account owner, such as "password changed".
# Defaults (hourly 10 + 15 + 5 = 30, daily 40 + 45 + 15 = 100) together fit the Resend free tier of 100 mails a day. Raise them when
# you move to a paid plan. Each hourly value must not exceed the daily value of the same pool.
# MAIL_BUDGET_REGISTRATION_PER_HOUR=10
# MAIL_BUDGET_REGISTRATION_PER_DAY=40
# MAIL_BUDGET_RESET_PER_HOUR=15
# MAIL_BUDGET_RESET_PER_DAY=45
# MAIL_BUDGET_SECURITY_PER_HOUR=5
# MAIL_BUDGET_SECURITY_PER_DAY=15
# Optional: daily cap per client address (an IPv6 address counts as its whole /64) on the requests that can cause mail: sign-ups, and
# forgot-password / resend-verification. Over the cap the request is answered as usual but sends no mail (default 10 each, 1-100000).
# MAIL_ADDRESS_REGISTRATION_PER_DAY=10
# MAIL_ADDRESS_RESET_PER_DAY=10
# Optional: most reset / resend-verification mails ONE recipient gets a day, whoever asks (1-1000, default 5). The answer to the request is
# the same either way, so the cap reveals nothing about an account.
# MAIL_RECIPIENT_RESET_PER_DAY=5
# Optional: limits against inventory hoarding by pending bookings.
# Open PENDING bookings per traveler (1-1000, default 10); how far ahead a service date may be (days, 1-1825, default 365);
# hours after creation until an unconfirmed PENDING booking expires and frees its capacity (1-720, default 48).
# BOOKING_MAX_PENDING_PER_TRAVELER=10
# BOOKING_MAX_DAYS_AHEAD=365
# BOOKING_PENDING_TTL_HOURS=48
